{
    "name": "apy/datagrid-bundle",
    "description": "Symfony Datagrid Bundle",
    "keywords": ["Symfony", "datagrid"],
    "homepage": "https://github.com/apy/APYDataGridBundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Yoann Petit",
            "email": "abhoryo@free.fr"
        },
        {
            "name": "Stanislav Turza",
            "email": "stanislav.turza@gmail.com"
        },
        {
            "name": "Evan Owens",
            "email": "eaowens@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.3",
        "twig/twig": "^2.6|^3.0",
        "doctrine/orm": "^2.6",
        "symfony/form": "~3.0|^4.0|^5.0",
        "symfony/dependency-injection": "~3.0|^4.0|^5.0",
        "symfony/config": "~3.0|^4.0|^5.0",
        "symfony/http-foundation": "~3.0|^4.0|^5.0",
        "symfony/http-kernel": "~3.0|^4.0|^5.0",
        "symfony/options-resolver": "~3.0|^4.0|^5.0",
        "symfony/security-guard": "~3.0|^4.0|^5.0",
        "symfony/serializer": "~3.0|^4.0|^5.0",
        "beberlei/doctrineextensions": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0",
        "friendsofphp/php-cs-fixer": "^2.0",
        "symfony/framework-bundle": "^4.3|^5.0",
        "symfony/browser-kit": "~3.0|^4.0|^5.0",
        "symfony/templating": "~3.0|^4.0|^5.0",
        "symfony/expression-language": "~3.0|^4.0|^5.0",
        "symfony/security-bundle": "~3.0|^4.0|^5.0",
        "symfony/twig-bundle": "~3.0|^4.0|^5.0"
    },
    "suggest": {
        "ext-intl": "Translate the grid",
        "ext-mbstring": "Convert your data with the right charset",
        "PHPExcel": "Export the grid (Excel, HTML or PDF)",
        "jms/translation-bundle": "If you want to use translations"
    },
    "autoload": {
        "psr-4": { "APY\\DataGridBundle\\": "" }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.1-dev"
        }
    }
}
